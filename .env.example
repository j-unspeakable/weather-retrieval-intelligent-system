# Copy this file to .env for local development. Never commit the real .env.
APP_ENV=local

# Lakebase OAuth parameters from a dedicated development branch's Connect dialog.
PGHOST=
PGDATABASE=databricks_postgres
PGUSER=
PGPORT=5432
PGSSLMODE=require
ENDPOINT_NAME=

# Authenticate separately with: databricks auth login --profile weather-dev
DATABRICKS_CONFIG_PROFILE=weather-dev

# OpenRouter chat-completions API used for grounded summaries.
LLM_API_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL_NAME=openrouter/free
LLM_REQUEST_TIMEOUT=45

# NWS asks API clients to identify themselves. Include real contact details.
WEATHER_USER_AGENT="weather-retrieval-system/0.1 (contact: you@example.com)"
NWS_API_BASE_URL=https://api.weather.gov
GEOCODING_API_BASE_URL=https://geocoding-api.open-meteo.com/v1
WEATHER_REQUEST_TIMEOUT=30
WEATHER_STATE_SYNC_WORKERS=6
